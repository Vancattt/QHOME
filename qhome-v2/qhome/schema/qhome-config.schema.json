{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QHome setup",
  "description": "Boards, devices and block scripts of a QHome installation (version 2.0.0).",
  "type": "object",
  "required": [
    "device",
    "boards",
    "components"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "device": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "node": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$",
          "description": "MQTT topic prefix; in node mode also the board id on the master."
        },
        "tz_offset": {
          "type": "number",
          "minimum": -12,
          "maximum": 14
        },
        "web_password": {
          "type": "string"
        },
        "role": {
          "enum": [
            "master",
            "node"
          ]
        },
        "master_host": {
          "type": "string"
        },
        "master_port": {
          "type": "integer"
        },
        "master_user": {
          "type": "string"
        },
        "master_pass": {
          "type": "string"
        }
      }
    },
    "mqtt": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "internal",
            "external",
            "off"
          ]
        },
        "port": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "ext_port": {
          "type": "integer"
        },
        "discovery": {
          "type": "boolean"
        },
        "prefix": {
          "type": "string"
        }
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "model",
          "link"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "name": {
            "type": "string"
          },
          "model": {
            "enum": [
              "unoq",
              "uno",
              "nano",
              "mega",
              "r4m",
              "r4w"
            ],
            "description": "unoq = Arduino UNO Q, uno = Arduino UNO R3, nano = Arduino Nano, mega = Arduino Mega 2560, r4m = Arduino UNO R4 Minima, r4w = Arduino UNO R4 WiFi"
          },
          "link": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "local",
                  "usb",
                  "uart",
                  "i2c",
                  "wifi"
                ],
                "description": "How the master reaches this board."
              },
              "port": {
                "type": "string",
                "description": "usb: serial port, \"auto\", \"helper:<name>\" or \"tcp://host:port\"."
              },
              "baud": {
                "enum": [
                  9600,
                  19200,
                  38400,
                  57600,
                  115200
                ]
              },
              "bus": {
                "enum": [
                  "wire",
                  "qwiic"
                ],
                "description": "i2c: SDA/SCL header or the Qwiic connector of the master."
              },
              "address": {
                "type": "integer",
                "minimum": 8,
                "maximum": 119
              },
              "poll_ms": {
                "type": "integer",
                "minimum": 10,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "binary_input",
              "analog_sensor",
              "pulse_counter",
              "switch_output",
              "pwm_output",
              "dac_output",
              "rgb_led",
              "led_matrix",
              "virtual_switch"
            ]
          },
          "board": {
            "type": [
              "string",
              "null"
            ],
            "description": "Board id; null for virtual switches."
          },
          "pin": {
            "description": "Arduino pin number (A0 is 14 on UNO boards, 54 on a Mega) or an on-board name.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 69
              },
              {
                "enum": [
                  "LED1",
                  "LED2",
                  "LED3",
                  "LED4",
                  "MATRIX"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "props": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "binary_input"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pull": {
                      "enum": [
                        "up",
                        "down",
                        "none"
                      ],
                      "default": "up"
                    },
                    "invert": {
                      "type": "boolean",
                      "default": true
                    },
                    "debounce": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2000,
                      "default": 30
                    },
                    "device_class": {
                      "enum": [
                        "",
                        "door",
                        "window",
                        "garage_door",
                        "motion",
                        "occupancy",
                        "presence",
                        "opening",
                        "smoke",
                        "moisture",
                        "vibration",
                        "power",
                        "problem",
                        "safety",
                        "lock",
                        "running"
                      ],
                      "default": ""
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "analog_sensor"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "interval": {
                      "type": "number",
                      "minimum": 50,
                      "maximum": 600000,
                      "default": 1000
                    },
                    "calib": {
                      "enum": [
                        "voltage",
                        "percent",
                        "raw",
                        "linear"
                      ],
                      "default": "voltage"
                    },
                    "in_min": {
                      "type": "number",
                      "default": 0
                    },
                    "in_max": {
                      "type": "number",
                      "default": 3.3
                    },
                    "out_min": {
                      "type": "number",
                      "default": 0
                    },
                    "out_max": {
                      "type": "number",
                      "default": 100
                    },
                    "unit": {
                      "type": "string",
                      "default": "V"
                    },
                    "decimals": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4,
                      "default": 2
                    },
                    "avg": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 50,
                      "default": 4
                    },
                    "delta": {
                      "type": "number",
                      "default": 0
                    },
                    "device_class": {
                      "enum": [
                        "",
                        "temperature",
                        "humidity",
                        "pressure",
                        "voltage",
                        "current",
                        "power",
                        "illuminance",
                        "distance",
                        "moisture",
                        "battery",
                        "volume_flow_rate",
                        "weight"
                      ],
                      "default": "voltage"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "pulse_counter"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "interval": {
                      "type": "number",
                      "minimum": 100,
                      "maximum": 600000,
                      "default": 1000
                    },
                    "mode": {
                      "enum": [
                        "rate",
                        "total"
                      ],
                      "default": "rate"
                    },
                    "multiplier": {
                      "type": "number",
                      "default": 1
                    },
                    "unit": {
                      "type": "string",
                      "default": "pulses/min"
                    },
                    "decimals": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4,
                      "default": 1
                    },
                    "device_class": {
                      "enum": [
                        "",
                        "temperature",
                        "humidity",
                        "pressure",
                        "voltage",
                        "current",
                        "power",
                        "illuminance",
                        "distance",
                        "moisture",
                        "battery",
                        "volume_flow_rate",
                        "weight"
                      ],
                      "default": ""
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "switch_output"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "invert": {
                      "type": "boolean",
                      "default": false
                    },
                    "restore": {
                      "enum": [
                        "off",
                        "on",
                        "restore"
                      ],
                      "default": "off"
                    },
                    "ha_as": {
                      "enum": [
                        "switch",
                        "light"
                      ],
                      "default": "switch"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "pwm_output"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "invert": {
                      "type": "boolean",
                      "default": false
                    },
                    "min_pct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "default": 0
                    },
                    "max_pct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "default": 100
                    },
                    "restore": {
                      "enum": [
                        "off",
                        "on",
                        "restore"
                      ],
                      "default": "off"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "dac_output"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "restore": {
                      "enum": [
                        "off",
                        "restore"
                      ],
                      "default": "off"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "rgb_led"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "restore": {
                      "enum": [
                        "off",
                        "restore"
                      ],
                      "default": "off"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "led_matrix"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "brightness": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 7,
                      "default": 4
                    },
                    "scroll_ms": {
                      "type": "number",
                      "minimum": 40,
                      "maximum": 1000,
                      "default": 120
                    },
                    "startup_text": {
                      "type": "string",
                      "default": "QHOME"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "virtual_switch"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "props": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "restore": {
                      "enum": [
                        "off",
                        "on",
                        "restore"
                      ],
                      "default": "restore"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "scripts": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "description": "Blockly workspace saved by the Blocks tab. Edit it there."
        }
      }
    }
  },
  "definitions": {
    "rgb_colors": {
      "enum": [
        "off",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan",
        "white"
      ]
    }
  }
}
